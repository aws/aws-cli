  {
    "id": "no-link",
    "documentation": "Nothing at $HOME/.aws/credential-daemon.sock and no AWS_CREDENTIAL_DAEMON_SOCKET: no location applies, so nothing is dialed, and the not-running error says to install the daemon or link its socket there, or to set AWS_CREDENTIAL_DAEMON_SOCKET (Socket location).",
    "platform": "linux",
    "configContents": "[profile dev]\ncredential_daemon = dev\n",
    "profile": "dev",
    "nextProvider": {
      "accessKeyId": "AKIDNEXTPROVIDER"
    },
    "daemon": {
      "sockets": []
    },
    "outcome": {
      "result": "error",
      "errorKind": "notRunning",
      "terminal": true,
      "errorCode": "NOT_RUNNING",
      "dialed": "none",
      "messageContains": [
        "credential-daemon.sock",
        "AWS_CREDENTIAL_DAEMON_SOCKET"
      ]
    }
  },
