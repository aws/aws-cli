#!/usr/bin/env python
"""Run the fake credential daemon for local development.

Usage
=====

Start it, then point the CLI at the socket it prints::

    scripts/credential-daemon-mock serve
    export AWS_CREDENTIAL_DAEMON_SOCKET=...

Send it calls, including the mock/* controls::

    scripts/credential-daemon-mock call credential/list
    scripts/credential-daemon-mock call mock/state

Run ``scripts/credential-daemon-mock serve --help`` for the options. The fake
lives in tests/utils/credential_daemon.
"""

import os
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO_ROOT)

from tests.utils.credential_daemon.__main__ import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
