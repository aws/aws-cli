{
  "version" : 2,
  "waiters" : {
    "AgentOrganizationalReportCompleted" : {
      "delay" : 15,
      "maxAttempts" : 40,
      "operation" : "GetAgentOrganizationalReport",
      "acceptors" : [ {
        "matcher" : "path",
        "argument" : "state",
        "state" : "success",
        "expected" : "COMPLETED"
      }, {
        "matcher" : "path",
        "argument" : "state",
        "state" : "failure",
        "expected" : "FAILED"
      }, {
        "matcher" : "path",
        "argument" : "state",
        "state" : "failure",
        "expected" : "DELETING"
      } ]
    }
  }
}