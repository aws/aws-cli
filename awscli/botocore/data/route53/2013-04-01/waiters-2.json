{
  "version": 2,
  "waiters": {
    "ResourceRecordSetsChanged": {
      "delay": 30,
      "maxAttempts": 60,
      "operation": "GetChange",
      "acceptors": [
        {
          "matcher": "path",
          "expected": "INSYNC",
          "argument": "ChangeInfo.Status",
          "state": "success"
        }
      ]
    },
    "HealthCheckSourceCreated": {
      "delay": 15,
      "maxAttempts": 40,
      "operation": "GetHealthCheckSource",
      "acceptors": [
        {
          "matcher": "path",
          "expected": "CREATE_COMPLETED",
          "argument": "HealthCheckSource.HealthCheckSourceStatus",
          "state": "success"
        },
        {
          "matcher": "path",
          "expected": "CREATE_FAILED",
          "argument": "HealthCheckSource.HealthCheckSourceStatus",
          "state": "failure"
        },
        {
          "matcher": "error",
          "expected": "NoSuchHealthCheckSource",
          "state": "retry"
        }
      ]
    },
    "HealthCheckSourceDeleted": {
      "delay": 15,
      "maxAttempts": 40,
      "operation": "GetHealthCheckSource",
      "acceptors": [
        {
          "matcher": "error",
          "expected": "NoSuchHealthCheckSource",
          "state": "success"
        },
        {
          "matcher": "path",
          "expected": "DELETE_COMPLETED",
          "argument": "HealthCheckSource.HealthCheckSourceStatus",
          "state": "success"
        },
        {
          "matcher": "path",
          "expected": "DELETE_FAILED",
          "argument": "HealthCheckSource.HealthCheckSourceStatus",
          "state": "failure"
        }
      ]
    }
  }
}
