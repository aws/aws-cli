{
    "version": "1.0",
    "testCases": [
        {
            "documentation": "A space ID that is not a host label is rejected rather than put in the host name.",
            "params": {
                "Region": "us-east-1",
                "SpaceId": "evil.example/#"
            },
            "expect": {
                "error": "Invalid SpaceId: must be a valid host label"
            }
        },
        {
            "documentation": "A Region that is not a host label is rejected.",
            "params": {
                "Region": "us-east-1/#"
            },
            "expect": {
                "error": "Invalid Configuration: Region must be a valid host label"
            }
        },
        {
            "documentation": "A space ID containing a dot is rejected rather than split across host labels.",
            "params": {
                "Region": "us-east-1",
                "SpaceId": "sp-abc.def123"
            },
            "expect": {
                "error": "Invalid SpaceId: must be a valid host label"
            }
        },
        {
            "documentation": "GetMemory goes to the endpoint of the space in its input.",
            "params": {
                "Region": "us-east-1",
                "SpaceId": "sp-abc123def456"
            },
            "operationInputs": [
                {
                    "operationName": "GetMemory",
                    "operationParams": {
                        "spaceId": "sp-abc123def456",
                        "memoryId": "mem-0123456789abcdef"
                    },
                    "builtInParams": {
                        "AWS::Region": "us-east-1"
                    }
                }
            ],
            "expect": {
                "endpoint": {
                    "url": "https://sp-abc123def456.osm.us-east-1.on.aws"
                }
            }
        },
        {
            "documentation": "ListSpaces goes to the regional endpoint.",
            "params": {
                "Region": "us-east-1"
            },
            "operationInputs": [
                {
                    "operationName": "ListSpaces",
                    "builtInParams": {
                        "AWS::Region": "us-east-1"
                    }
                }
            ],
            "expect": {
                "endpoint": {
                    "url": "https://osm.us-east-1.api.aws"
                }
            }
        },
        {
            "documentation": "With a space ID: the space's endpoint.",
            "params": {
                "Region": "us-east-1",
                "SpaceId": "sp-abc123def456"
            },
            "expect": {
                "endpoint": {
                    "url": "https://sp-abc123def456.osm.us-east-1.on.aws"
                }
            }
        },
        {
            "documentation": "Without a space ID: the regional endpoint.",
            "params": {
                "Region": "us-east-1"
            },
            "expect": {
                "endpoint": {
                    "url": "https://osm.us-east-1.api.aws"
                }
            }
        },
        {
            "documentation": "Endpoint override with a space ID: the override URL.",
            "params": {
                "Region": "us-east-1",
                "SpaceId": "sp-000000000000",
                "Endpoint": "https://example.com"
            },
            "expect": {
                "endpoint": {
                    "url": "https://example.com"
                }
            }
        },
        {
            "documentation": "Endpoint override without a space ID: the override URL.",
            "params": {
                "Region": "us-east-1",
                "Endpoint": "https://example.com"
            },
            "expect": {
                "endpoint": {
                    "url": "https://example.com"
                }
            }
        },
        {
            "documentation": "FIPS without a space ID fails: the service has no FIPS endpoint.",
            "params": {
                "Region": "us-east-1",
                "UseFIPS": true
            },
            "expect": {
                "error": "Invalid Configuration: FIPS is not supported with OpenSearch Memory."
            }
        },
        {
            "documentation": "FIPS with a space ID fails: the service has no FIPS endpoint.",
            "params": {
                "Region": "us-east-1",
                "SpaceId": "sp-abc123def456",
                "UseFIPS": true
            },
            "expect": {
                "error": "Invalid Configuration: FIPS is not supported with OpenSearch Memory."
            }
        },
        {
            "documentation": "FIPS with an endpoint override fails.",
            "params": {
                "Region": "us-east-1",
                "Endpoint": "https://example.com",
                "UseFIPS": true
            },
            "expect": {
                "error": "Invalid Configuration: FIPS and custom endpoint are not supported"
            }
        },
        {
            "documentation": "GetMemory with FIPS on fails rather than going to the space's endpoint.",
            "params": {
                "Region": "us-east-1",
                "SpaceId": "sp-abc123def456",
                "UseFIPS": true
            },
            "operationInputs": [
                {
                    "operationName": "GetMemory",
                    "operationParams": {
                        "spaceId": "sp-abc123def456",
                        "memoryId": "mem-0123456789abcdef"
                    },
                    "builtInParams": {
                        "AWS::Region": "us-east-1",
                        "AWS::UseFIPS": true
                    }
                }
            ],
            "expect": {
                "error": "Invalid Configuration: FIPS is not supported with OpenSearch Memory."
            }
        },
        {
            "documentation": "ListSpaces with FIPS on fails rather than going to the regional endpoint.",
            "params": {
                "Region": "us-east-1",
                "UseFIPS": true
            },
            "operationInputs": [
                {
                    "operationName": "ListSpaces",
                    "builtInParams": {
                        "AWS::Region": "us-east-1",
                        "AWS::UseFIPS": true
                    }
                }
            ],
            "expect": {
                "error": "Invalid Configuration: FIPS is not supported with OpenSearch Memory."
            }
        }
    ]
}