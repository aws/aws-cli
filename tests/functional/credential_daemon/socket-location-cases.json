[
  {
    "id": "success-basic",
    "documentation": "Keys, token, expiry and account ID from credential/get (Calling the daemon).",
    "platform": "linux",
    "configContents": "[profile dev]\ncredential_daemon = dev\n",
    "profile": "dev",
    "nextProvider": {
      "accessKeyId": "AKIDNEXTPROVIDER"
    },
    "daemon": {
      "sockets": [
        "link"
      ],
      "exchanges": [
        {
          "expectedRequest": {
            "method": "credential/get",
            "params": {
              "credential": "dev"
            }
          },
          "replyLines": [
            {
              "jsonrpc": "2.0",
              "id": "$id",
              "result": {
                "credential": "dev",
                "material": {
                  "type": "session_credentials",
                  "access_key_id": "ASIADAEMON",
                  "secret_access_key": "s3cr3t",
                  "session_token": "token",
                  "account_id": "123456789012"
                },
                "provenance": "cached_shared",
                "expires_at": "2026-11-01T00:15:00Z"
              }
            }
          ]
        }
      ]
    },
    "outcome": {
      "result": "credentials",
      "dialed": "link",
      "source": "daemon",
      "accessKeyId": "ASIADAEMON",
      "secretAccessKey": "s3cr3t",
      "sessionToken": "token",
      "accountId": "123456789012",
      "expiresAt": "2026-11-01T00:15:00Z"
    }
  },
  {
    "id": "not-running",
    "documentation": "$HOME/.aws/credential-daemon.sock links to a socket that nothing listens on: the not-running error names that path and how to start the daemon. terminal: SDKs whose chain moves on (Errors) assert the error from the provider.",
    "platform": "linux",
    "configContents": "[profile dev]\ncredential_daemon = dev\n",
    "profile": "dev",
    "nextProvider": {
      "accessKeyId": "AKIDNEXTPROVIDER"
    },
    "daemon": {
      "sockets": [
        "link-stale"
      ]
    },
    "outcome": {
      "result": "error",
      "errorKind": "notRunning",
      "terminal": true,
      "errorCode": "NOT_RUNNING",
      "dialed": "link",
      "messageContains": [
        "daemon",
        "credential-daemon.sock"
      ]
    }
  },
