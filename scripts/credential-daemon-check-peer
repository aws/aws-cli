#!/usr/bin/env python
"""Check a credential daemon socket the way commands that send secrets do.

With no SOCKET_PATH, it checks the socket the CLI would dial
(AWS_CREDENTIAL_DAEMON_SOCKET, then ~/.aws/credential-daemon.sock).

It runs each check in turn and prints ``pass`` or the reason it failed:

1. link (~/.aws/credential-daemon.sock only): the link's target is
   there, as every client checks (~/.aws and the link get no owner or
   mode checks);
2. path: who owns the socket and the folders above it;
3. peer uid: which user serves it (SO_PEERCRED or LOCAL_PEERCRED);
4. code signature (macOS only, the system socket too): that the
   process serving it is the signed credential daemon, through
   Security.framework.

It runs the later checks even after one fails, so it can say every reason a
daemon is refused. It connects but sends nothing. The exit status is 0 only
if every check passes.
"""

import argparse
import os
import socket
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, REPO_ROOT)

from awscli.botocore import credential_daemon as cd  # noqa: E402

# isort: split
# The class the checks raise, as credential_daemon imports it.
from botocore.exceptions import CredentialDaemonError  # noqa: E402


def _os_error_text(error):
    # The OS's text, without Python's "[Errno n]" prefix, through the
    # module's public sanitizer rather than its private helper.
    return cd.strip_control_characters(error.strerror or str(error))


def _report(name, check):
    try:
        result = check()
    except CredentialDaemonError as e:
        print(f'{name}: refused: {e}')
        return False, None
    print(f'{name}: pass')
    return True, result


def main(argv):
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'socket_path',
        nargs='?',
        metavar='SOCKET_PATH',
        help='the socket to check (default: the one the CLI would dial)',
    )
    args = parser.parse_args(argv)
    path = args.socket_path
    if path is None:
        path = cd.default_socket_path()
    elif path == cd.home_socket_path():
        # Given by hand, it still gets the link check every client runs.
        path = cd.HomeSocketPath(path)
    if path is None:
        print('The credential daemon doesn\'t run on this platform.')
        return 1
    if isinstance(path, cd.NoSocketPath):
        if path:
            where = f'nothing is at {cd.strip_control_characters(str(path))}'
        else:
            where = (
                'HOME isn\'t an absolute path, so there\'s no '
                f'{cd.SHOWN_HOME_SOCKET}'
            )
        print(
            f'No socket: {where}, and {cd.DAEMON_SOCKET_ENV_VAR} isn\'t set '
            'to an absolute path.'
        )
        return 1
    print(f'socket: {cd.strip_control_characters(str(path))}')
    print(f'requirement: {cd.CREDENTIAL_DAEMON_CODE_REQUIREMENT}')
    ok = True
    if isinstance(path, cd.HomeSocketPath):
        if os.path.islink(path):
            target = cd.strip_control_characters(os.path.realpath(path))
            print(f'link: -> {target}')
        ok, _ = _report('link', lambda: cd.check_home_socket(path))
    path_ok, checked = _report('path', lambda: cd.check_socket(path))
    ok = ok and path_ok
    if checked is not None:
        canon, owner = checked
    else:
        # Go on to the peer checks anyway, on the resolved path. The socket
        # wasn't trusted, so its owner doesn't count: only this user and
        # root do, or another user's daemon would pass the peer check.
        canon = os.path.realpath(path)
        owner = os.geteuid()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(cd.CONNECT_TIMEOUT)
    with sock:
        try:
            sock.connect(canon)
        except OSError as e:
            print(f'connect: refused: {_os_error_text(e)}')
            return 1
        uid_ok, _ = _report(
            'peer uid', lambda: cd.check_peer(sock, canon, owner, given=path)
        )
        ok = ok and uid_ok
        if not cd.checks_code_signature():
            print('code signature: not checked (macOS only)')
        else:
            sig_ok, _ = _report(
                'code signature',
                lambda: cd.check_code_signature(sock, canon, given=path),
            )
            ok = ok and sig_ok
    print('result: pass' if ok else 'result: refused')
    return 0 if ok else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
