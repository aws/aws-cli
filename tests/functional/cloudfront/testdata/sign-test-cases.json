  {
    "id": "ecdsa-canned-policy-url",
    "documentation": "Sign a URL with ECDSA key and canned policy. ECDSA signatures are non-deterministic, so verify cryptographically against the public key rather than matching a fixed signature.",
    "input": {
      "resource": "https://d111111abcdef8.cloudfront.net/video.mp4",
      "keyPairId": "K2ECDSATEST",
      "privateKeyFile": "test-ecdsa-key.pem",
      "expirationDate": 1767290400,
      "hashAlgorithm": "SHA256"
    },
    "expected": {
      "policyJson": "{\"Statement\":[{\"Resource\":\"https://d111111abcdef8.cloudfront.net/video.mp4\",\"Condition\":{\"DateLessThan\":{\"AWS:EpochTime\":1767290400}}}]}",
      "queryParams": {
        "Expires": "1767290400",
        "Key-Pair-Id": "K2ECDSATEST",
        "Hash-Algorithm": "SHA256"
      },
      "verifyCryptographically": true,
      "signatureAlgorithm": "ECDSA-SHA256"
    }
  },
  {
    "id": "ecdsa-canned-policy-url-sha1-reject",
    "documentation": "SDKs that constrain ECDSA to SHA-256 (see Hash Algorithms): verify ECDSA+SHA-1 is rejected with an error. SDKs that support this combination instead MUST NOT run this case; see ecdsa-canned-policy-url-sha1-accept.",
    "input": {
      "resource": "https://d111111abcdef8.cloudfront.net/video.mp4",
      "keyPairId": "K2ECDSATEST",
      "privateKeyFile": "test-ecdsa-key.pem",
      "expirationDate": 1767290400,
      "hashAlgorithm": "SHA1"
    },
    "expected": {
      "error": true,
      "errorContains": [
        "SHA"
      ],
      "returnCode": 252
    }
  },
