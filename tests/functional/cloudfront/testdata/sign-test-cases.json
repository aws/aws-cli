  {
    "id": "canned-policy-url-basic",
    "documentation": "Sign a URL with canned policy (expiration only), RSA-SHA1 (default hash)",
    "input": {
      "resource": "https://d111111abcdef8.cloudfront.net/image.jpg",
      "keyPairId": "K1TESTKEY",
      "privateKeyFile": "test-rsa-key.pem",
      "expirationDate": 1767290400
