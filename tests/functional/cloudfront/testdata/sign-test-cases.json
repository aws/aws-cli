  {
    "id": "error-missing-expiration",
    "documentation": "Error when expiration date is not provided",
    "input": {
      "resource": "https://d111111abcdef8.cloudfront.net/file.txt",
      "keyPairId": "K1TESTKEY",
      "privateKeyFile": "test-rsa-key.pem"
    },
    "expected": {
      "error": true,
      "errorContains": [
        "--date-less-than",
        "required"
      ],
      "returnCode": 252
    }
  },
  {
    "id": "error-active-after-expiration",
    "documentation": "Error when activeDate is after expirationDate",
    "input": {
      "resource": "https://d111111abcdef8.cloudfront.net/file.txt",
      "keyPairId": "K1TESTKEY",
      "privateKeyFile": "test-rsa-key.pem",
      "expirationDate": 1767200000,
      "activeDate": 1767290400
    },
    "expected": {
      "error": true,
      "errorContains": [
        "active",
        "before",
        "expiration"
      ],
      "returnCode": 252
    }
  },
  {
    "id": "error-unsupported-key-type",
    "documentation": "Error when a valid key of an unsupported type (DSA) is provided. Only RSA and ECDSA (P-256) are supported.",
    "input": {
      "resource": "https://d111111abcdef8.cloudfront.net/video.mp4",
      "keyPairId": "K1TESTKEY",
      "privateKeyFile": "test-dsa-key.pem",
      "expirationDate": 1767290400
    },
    "expected": {
      "error": true,
      "errorContains": [
        "key",
        "RSA",
        "ECDSA"
      ],
      "returnCode": 255
    }
  },
  {
    "id": "json-injection-resource-url-reject",
    "documentation": "SDKs that reject rather than escape (preferred, see Policy JSON Construction): verify a resource containing double quotes is rejected with an error. SDKs that escape unsafe characters instead MUST NOT run this case; see json-injection-resource-url-escape.",
    "input": {
      "resource": "https://example.com/file\",\"Resource\":\"*\",\"x\":\"",
      "keyPairId": "K1TESTKEY",
      "privateKeyFile": "test-rsa-key.pem",
      "expirationDate": 1767290400
    },
    "expected": {
      "error": true,
      "errorContains": [
        "--url",
        "resource"
      ],
      "returnCode": 252
    }
  },
  {
    "id": "json-injection-ip-range-reject",
    "documentation": "SDKs that reject rather than escape (preferred, see Policy JSON Construction): verify an ipRange containing double quotes is rejected with an error. SDKs that escape unsafe characters instead MUST NOT run this case; see json-injection-ip-range-escape.",
    "input": {
      "resource": "https://d111111abcdef8.cloudfront.net/image.jpg",
      "keyPairId": "K1TESTKEY",
      "privateKeyFile": "test-rsa-key.pem",
      "expirationDate": 1767290400,
      "ipRange": "192.168.0.0/24\",\"IpAddress\":{\"AWS:SourceIp\":\"0.0.0.0/0"
    },
    "expected": {
      "error": true,
      "errorContains": [
        "--ip-address"
      ],
      "returnCode": 252
    }
  }
]
